{
    "name": "@dukatiq/server",
    "private":true,
    "version": "1.0.0",
    "type": "module",
    "description": "Backend API for Shop Profit Booster",
    "main": "src/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon src/server.js",
        
        "start": "cross-env NODE_ENV=production node src/server.js",
        
        
        "db:generate": "cross-env NODE_ENV=development drizzle-kit generate",
        "db:migrate": "cross-env NODE_ENV=production drizzle-kit migrate",
        "db:pull": "cross-env NODE_ENV=development drizzle-kit pull",
        "db:studio": "cross-env NODE_ENV=development drizzle-kit studio",
        "db:reset": "cross-env NODE_ENV=development drizzle-kit drop && drizzle-kit push",
        
        "db:run": "cross-env NODE_ENV=development docker compose --env-file .env.development -f docker-compose.yml -f docker-compose.dev.yml up dukatiq-postgres",

          "test": "cross-env NODE_ENV=test vitest",
        "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
    },
    "keywords": [
        "shop",
        "retail",
        "analytics",
        "profit"
    ],
    "author": "Kevin Kibet",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1075.0",
        "@aws-sdk/s3-request-presigner": "^3.1075.0",
        "argon2": "^0.44.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dayjs": "^1.11.21",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "helmet": "^8.2.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "ulid": "^3.0.2",
        "uuidv4": "^6.2.13",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.9",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^1.0.0-rc.4",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "vitest": "^4.1.9"
    }
}
