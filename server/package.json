{
    "name": "dukatiq",
    "version": "1.0.0",
    "type": "module",
    "description": "Backend API for Shop Profit Booster",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "typeorm": "typeorm -d ./src/config/database.js",
        "migration:generate": "npm run typeorm -- migration:generate",
        "migration:create": "npm run typeorm -- migration:create",
        "migration:run": "npm run typeorm -- migration:run",
        "migration:revert": "npm run typeorm -- migration:revert",
        "test": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [
        "shop",
        "retail",
        "analytics",
        "profit"
    ],
    "author": "Kevin Kibet",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1075.0",
        "@aws-sdk/s3-request-presigner": "^3.1075.0",
        "argon2": "^0.44.0",
        "better-sqlite3": "^12.11.1",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dayjs": "^1.11.21",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.2.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1",
        "typeorm": "^1.0.0",
        "ulid": "^3.0.2",
        "uuidv4": "^6.2.13",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.9",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.2.2",
        "vitest": "^4.1.9"
    }
}
